# Database Connections (Supabase PostgreSQL with PostGIS)
# Note: Ensure the PostGIS extension is enabled on your Supabase project (Database -> Extensions -> postgis).

# Pooled connection (Transaction pooler, Port 6543) - used by FastAPI at runtime for optimal connection management
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres

# Direct connection (Port 5432) - required by Alembic for migrations (DDL requires session-mode / direct connection)
DATABASE_URL_DIRECT=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Authentication
JWT_SECRET_KEY=generate-a-secure-random-32-byte-hex-key-here
JWT_EXPIRE_MINUTES=1440
